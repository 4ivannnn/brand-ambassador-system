# Copy this file to ".env" and edit the values.
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/brand_ambassador
SECRET_KEY=replace-this-with-a-long-random-string
TOKEN_TTL_MINUTES=480

# Qualification engine (ML)
MODEL_PATH=models/qualification_model.joblib
CONFIDENCE_THRESHOLD=0.75
FRAUD_FLAG_THRESHOLD=0.50

# Optional: e-mail notifications (leave SMTP_HOST empty to keep dashboard-only notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com
